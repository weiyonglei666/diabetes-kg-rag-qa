# ============================================================================
# 环境变量配置文件
# ============================================================================
# 说明：
# 1. 本文件用于配置项目所需的所有敏感信息（API 密钥、数据库密码等）
# 2. 请勿将此文件提交到版本控制系统（已添加到 .gitignore）
# 3. 复制本文件为 .env 并填入真实的密钥值
# 4. 所有密钥值必须使用英文引号包裹
#
# 获取 API Key 的官方地址：
# - DeepSeek: https://platform.deepseek.com/
# - Moonshot (Kimi): https://platform.moonshot.cn/
# - 智谱 GLM: https://open.bigmodel.cn/
# - 阿里云百炼 (Qwen): https://dashscope.aliyun.com/
# ============================================================================

# ----------------------------------------------------------------------------
# Neo4j 图数据库配置
# ----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ----------------------------------------------------------------------------
# DeepSeek API 配置
# ----------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# ----------------------------------------------------------------------------
# Moonshot (Kimi) API 配置
# ----------------------------------------------------------------------------
MOONSHOT_API_KEY=sk-your_moonshot_api_key_here

# ----------------------------------------------------------------------------
# 智谱 GLM API 配置
# ----------------------------------------------------------------------------
GLM_API_KEY=your_glm_api_key_here

# ----------------------------------------------------------------------------
# 阿里云百炼 (DashScope) API 配置
# ----------------------------------------------------------------------------
DASHSCOPE_API_KEY=sk-your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ----------------------------------------------------------------------------
# 其他可选配置
# ----------------------------------------------------------------------------
# LLM 请求超时时间（秒）
LLM_TIMEOUT=120

# 知识图谱检索返回的最大条目数
TOPK=10

# KG 上下文最大条目数
KG_CONTEXT_MAX_ITEMS=8

# RAG 检索 top-k
RAG_TOP_K=5

# KG 检索 top-k
KG_TOP_K=10

# 融合检索 top-k
FUSION_TOP_K=8

# RAG 最小相似度分数
RAG_MIN_SCORE=0.0

# 图谱默认节点限制
GRAPH_DEFAULT_LIMIT=80

# 图谱邻居节点限制
GRAPH_NEIGHBOR_LIMIT=40

# 图谱搜索限制
GRAPH_SEARCH_LIMIT=60

# 图谱主题限制
GRAPH_TOPIC_LIMIT=70

# 热点术语限制
HOT_TERMS_LIMIT=10
